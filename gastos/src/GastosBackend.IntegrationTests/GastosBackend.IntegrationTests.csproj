<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests against a real PostgreSQL started in a container (Docker must be running).
       The fast mock-based tests live in GastosBackend.Tests and do not need Docker. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GastosBackend.Infrastructure\GastosBackend.Infrastructure.csproj" />
    <ProjectReference Include="..\GastosBackend.Application\GastosBackend.Application.csproj" />
    <ProjectReference Include="..\GastosBackend.Domain\GastosBackend.Domain.csproj" />
  </ItemGroup>

</Project>
