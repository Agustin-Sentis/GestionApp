{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GastosConnectionStrings": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Gastos",
    "Audience": "GastosClients",
    "ExpirationMinutes": "60"
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:5173"
  },
  "Https": {
    "Hsts": {
      "Enabled": false,
      "MaxAgeDays": 30
    }
  },
  "Docs": {
    "Enabled": false
  },
  "Health": {
    "DatabaseTimeoutSeconds": 8
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "DolarApi": {
    "BaseUrl": "https://dolarapi.com/",
    "Casa": "oficial",
    "CacheMinutes": "15"
  }
}
