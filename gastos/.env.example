# Copiá este archivo a ".env" y completá los valores. ".env" NO se sube al repo.

# Contraseña de PostgreSQL
DB_PASSWORD=

# Clave de firma de los JWT (mínimo 32 caracteres). Generala con:  openssl rand -base64 48
JWT_KEY=

# Origen del front que puede llamar a la API (CORS)
FRONTEND_URL=http://localhost:5173

# Avisos por correo con Brevo (opcional: sin clave no se manda nada, los correos solo se registran en el log).
# La clave se crea en Brevo con acceso "Restricted" y solo "Transactional email: All". Vence a los 90 días sin uso.
# EMAIL_SENDER tiene que ser una dirección verificada en Brevo (Senders, domains & dedicated IPs).
BREVO_API_KEY=
EMAIL_SENDER=

# Solo si levantás el front con:  docker compose --profile web up --build
VITE_API_URL=http://localhost:8080
